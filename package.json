{
  "name": "dsh-argp",
  "version": "1.0.5",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "type": "module",
  "description": "Guarded context compaction for DeepSeek Harness (dsh): the LLM proposes, deterministic guards dispose — eager per-atom shrink (extract/summary/false under verbatim guards) + lazy reference-graph eviction (0-LLM) + byte-exact recall from an append-only log. 压缩率精确兑现，历史永不销毁。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoza10635/dsh-argp.git"
  },
  "bugs": {
    "url": "https://github.com/yoza10635/dsh-argp/issues"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "npm publish && git tag v$(node -p \"require('./package.json').version\") && git push origin main --tags",
    "spike1": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/01-mount.ts",
    "spike2": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/02-surfaceop.ts",
    "spike3": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/03-recall.ts",
    "spike4a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/04a-adapter-smoke.ts",
    "spike4": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/04-t1.ts",
    "spike5": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/05-t8.ts",
    "spike6": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/06-tlong.ts",
    "spike7": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/07-baseline.ts",
    "smoke": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/dev-smoke.ts",
    "test": "node --import ./scripts/ts-import-rewrite-loader.mjs --test test/*.test.ts",
    "check": "npm run typecheck && npm run smoke && npm test",
    "smoke:deepseek": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/10a-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10b-basic-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10d-argp-deepseek-smoke.ts",
    "spike8a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/08a-production-synthetic.ts",
    "spike26": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/26-tlong-coding.ts",
    "spike7real": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/07-real-trace.ts",
    "spike32": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/32-split-repr-compare.ts",
    "spike33": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/33-peratom-live.ts",
    "spike34": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/34-extract-fidelity.ts",
    "spike35": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/35-peratom-agentloop.ts",
    "spike36": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/36-peratom-soak.ts",
    "spike8": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/08-game-trace.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell-env": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-bash": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.5.0"
  }
}
