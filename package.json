{
  "name": "dsh-argp",
  "version": "2.0.0-alpha.0",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./engine": "./lib/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "SECURITY.md"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "description": "Factor context compaction for DeepSeek Harness (dsh): deterministic label-addressed eviction of tool results (0-LLM), prose condensation as the only LLM path (double-gated, transaction-only), and an egress gate that never sends a request that would necessarily overflow. Everything evicted stays in the append-only log and comes back verbatim by label. 剪枝确定、遗忘可撤销。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "harness",
    "cordis",
    "compaction",
    "context-compression",
    "context-window",
    "agent",
    "llm",
    "token-optimization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoza10635/dsh-argp.git"
  },
  "bugs": {
    "url": "https://github.com/yoza10635/dsh-argp/issues"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:spike": "tsc -p tsconfig.spike.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm run typecheck:spike && npm test && npm run build",
    "prerelease:check": "node scripts/prerelease-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release": "npm run prerelease:check && node scripts/prerelease-check.mjs --tag && npm publish && git push origin main --tags",
    "spike2": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/02-surfaceop.ts",
    "spike4a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/04a-adapter-smoke.ts",
    "spike5": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/05-t8.ts",
    "spike6": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/06-tlong.ts",
    "spike7": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/07-baseline.ts",
    "smoke": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/dev-smoke.ts",
    "test": "node --import ./scripts/ts-import-rewrite-loader.mjs --test test/*.test.ts",
    "test:live": "node --import ./scripts/ts-import-rewrite-loader.mjs --import ./scripts/live-env.mjs --test test/integration-live.test.ts",
    "check": "npm run typecheck && npm run typecheck:spike && npm run smoke && npm test && npm run build",
    "smoke:deepseek": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/10a-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10b-basic-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10d-argp-deepseek-smoke.ts",
    "spike8a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/08a-production-synthetic.ts",
    "spike26": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/26-tlong-coding.ts",
    "spike7real": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/07-real-trace.ts",
    "spike32": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/32-split-repr-compare.ts",
    "spike48": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/48-tag-extract-audit.ts",
    "spike49": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/49-recall-attribution.ts",
    "t2": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/50-t2-replay.ts",
    "oracle": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/51-oracle-judge.ts",
    "classb": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/52-classb-oracle.ts",
    "errdedup": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/53-error-dedup.ts",
    "policy": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/54-policy-width.ts",
    "vercmp": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/55-version-compare.ts",
    "spike8": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/08-game-trace.ts"
  },
  "overrides": {
    "@deepseek-ai/cordis": "4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.24.2",
    "semver": "^7.8.5",
    "typescript": "^5.7.0"
  }
}
