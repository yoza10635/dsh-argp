{
  "name": "dsh-argp",
  "version": "0.2.6",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "type": "module",
  "description": "ARGP (Atomic Reference Graph Pruning): a logical-chain context-compaction engine for DeepSeek Harness (dsh) — reference-dependency pruning with zero LLM calls, mounted as a third-party CompactionEngine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoza10635/dsh-argp.git"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "npm publish && git tag v$(node -p \"require('./package.json').version\") && git push origin main --tags",
    "spike1": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/01-mount.ts",
    "spike2": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/02-surfaceop.ts",
    "spike3": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/03-recall.ts",
    "spike4a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/04a-adapter-smoke.ts",
    "spike4": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/04-t1.ts",
    "spike5": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/05-t8.ts",
    "spike6": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/06-tlong.ts",
    "spike7": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/07-baseline.ts",
    "smoke": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/dev-smoke.ts",
    "test": "node --import ./scripts/ts-import-rewrite-loader.mjs --test test/*.test.ts",
    "check": "npm run typecheck && npm run smoke && npm test",
    "smoke:deepseek": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/10a-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10b-basic-deepseek-smoke.ts && node --import ./scripts/ts-import-rewrite-loader.mjs spike/10d-argp-deepseek-smoke.ts",
    "spike8a": "node --import ./scripts/ts-import-rewrite-loader.mjs spike/08a-production-synthetic.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-token-meter": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tool-bash": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "typescript": "^5.5.0"
  }
}