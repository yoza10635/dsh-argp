{
  "name": "dsh-argp",
  "version": "0.1.0",
  "main": "src/index.ts",
  "exports": "./src/index.ts",
  "type": "module",
  "description": "ARGP (Atomic Reference Graph Pruning): a 0-LLM deterministic context-compaction engine for DeepSeek Harness (dsh), mounted as a third-party CompactionEngine.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spike1": "node spike/01-mount.ts",
    "spike2": "node spike/02-surfaceop.ts",
    "spike3": "node spike/03-recall.ts",
    "spike4a": "node spike/04a-adapter-smoke.ts",
    "spike4": "node spike/04-t1.ts",
    "spike5": "node spike/05-t8.ts",
    "spike6": "node spike/06-tlong.ts",
    "spike7": "node spike/07-baseline.ts",
    "smoke": "node spike/dev-smoke.ts",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm run smoke && npm test",
    "smoke:deepseek": "node spike/10a-deepseek-smoke.ts && node spike/10b-basic-deepseek-smoke.ts && node spike/10d-argp-deepseek-smoke.ts",
    "spike8a": "node spike/08a-production-synthetic.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
